{
  "name": "localpdf",
  "version": "0.9.0-beta.7",
  "description": "A PDF editor for Windows that keeps your documents on your computer",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "postinstall": "node node_modules/electron/install.js && node scripts/copy-pdfjs-assets.mjs",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "test:e2e": "electron-vite build && playwright test",
    "build:extension": "node scripts/build-extension.mjs",
    "test:extension": "node scripts/build-extension.mjs && playwright test --config playwright.extension.config.ts"
  },
  "author": "PuchBuch",
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdf-lib/standard-fonts": "1.0.0",
    "immer": "^11.2.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "signature_pad": "^5.1.4",
    "tesseract.js": "7.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@expo-google-fonts/carlito": "0.4.1",
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/cousine": "0.4.3",
    "@expo-google-fonts/roboto-mono": "^0.4.2",
    "@expo-google-fonts/tinos": "0.4.2",
    "@napi-rs/canvas": "^1.1.0",
    "@playwright/test": "^1.65.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/ita": "1.0.0",
    "@tesseract.js-data/pol": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@tesseract.js-data/ukr": "1.0.0",
    "@types/chrome": "0.0.300",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "private": true
}
